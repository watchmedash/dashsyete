{
  "name": "dash-city",
  "version": "1.0.0",
  "description": "SIX SIDES - cube-planet blaster deathmatch",
  "author": "watchmedash",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -n srv,web \"tsx watch server/src/index.ts\" \"vite client\"",
    "editor": "concurrently -k \"vite --config vite.editor.config.ts\" \"wait-on http://localhost:5199/editor.html && electron editor-app/main.cjs\"",
    "assets": "node scripts/copy-assets.mjs",
    "build": "vite build client",
    "start": "npm run build && tsx server/src/index.ts",
    "desktop": "npm run build && node desktop/build.mjs && electron desktop/main.cjs",
    "installer": "npm run build && node desktop/build.mjs && electron-builder --win nsis",
    "apk": "node scripts/build-apk.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.sixsides.game",
    "productName": "SIX SIDES",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/server.cjs",
      "desktop/icon.png",
      "desktop/web/**",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "three": "^0.185.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
